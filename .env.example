# Copy this file to .env and fill it in.

# ---------------------------------------------------------------- cameras
# Any RTSP (or HTTP/MJPEG) URL works. Add CAM3_..., CAM4_... for more cameras.
# Examples:
#   Wyze through the bridge:  rtsp://wyze-bridge:8554/puppy_cam
#   Wyze RTSP firmware:       rtsp://user:password@192.168.1.50/live
#   Tapo / TP-Link:           rtsp://user:password@192.168.1.51:554/stream1
#   Reolink:                  rtsp://admin:password@192.168.1.52:554/h264Preview_01_main
CAM1_NAME=Wyze top
CAM1_URL=rtsp://user:password@192.168.1.50/live
CAM2_NAME=Side cam
CAM2_URL=rtsp://user:password@192.168.1.51:554/stream1

# ---------------------------------------------------------------- the litter
EXPECTED_PUPPIES=9

# Your time zone, so times on the video and in file names are local
TZ=America/New_York

# ---------------------------------------------------------------- phone alerts
# Free: install the "ntfy" app (Android/iPhone) and subscribe to the same topic.
# Use a long random name, anyone who knows it can read your alerts.
NTFY_TOPIC=
# Optional extra: a webhook (Home Assistant, Discord, Slack...)
WEBHOOK_URL=

# How long before an alert fires
AWAY_SECONDS=60
COUNT_LOW_MINUTES=10
MOM_AWAY_MINUTES=20
OFFLINE_MINUTES=2
ALERT_REPEAT_MINUTES=15

# ---------------------------------------------------------------- Wyze bridge
# Only used with: docker compose --profile wyze up -d
# API ID and key: https://developer-api-console.wyze.com/#/apikey/view
WYZE_EMAIL=
WYZE_PASSWORD=
WYZE_API_ID=
WYZE_API_KEY=

# ---------------------------------------------------------------- advanced
# WEB_PASSWORD=           # protect the web page (any user name + this password)
# IMGSZ=1280              # model input size
# PROCESS_FPS=4           # detection passes per second
# DEVICE=0                # GPU index, or "cpu"
# GRAYSCALE=true          # treat color (day) and infrared (night) frames alike
# CONF=                   # force a confidence threshold instead of the tuned one
# CLAMP_TO_EXPECTED=true  # never report more puppies than EXPECTED_PUPPIES
# CAPTURE_EVERY_MINUTES=10  # save a frame for labeling this often (0 = off)
# CAPTURE_UNCERTAIN=true  # save frames where the model is unsure
